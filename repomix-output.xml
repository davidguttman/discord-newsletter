function findMessageByType (type) {
  const typeMap = {
    plainText: 'plain text message',
    userMention: 'user mention <@367727560869675018>',
    roleMention: 'role mention <@&1014398560625754154>',
    channelMention: 'channel mention <#1014254487898177668>',
