    prompt_tokens: Number,
    completion_tokens: Number,
    total_tokens: Number
  },
  metadata: {
    approach: String,
    topicsFound: Number,
    storiesGenerated: Number,
    topics: [{
      description: String,
      substance: Number
    }]
  },
  createdAt: {
